<section
  id="contact-text-image-cards-{{ section.id }}"
  class="contact-text-image-cards page-width"
  style="
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>
  <div
    class="contact-text-image-cards__inner"
    style="
      {% if section.settings.background_color %}
         background:#FAFAFA;
      {% endif %}
    "
  >
    <div
      class="contact-text-image-cards__content"
      style="--content-alignment: {{ section.settings.content_alignment }};"
    >
      <div class="contact-text-image-cards__content-inner">
        {% if section.settings.heading != blank %}
          <h2 class="contact-text-image-cards__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        <div class="contact-text-image-cards__details">
          {% for block in section.blocks %}
            {% if block.type == 'contact_detail' %}
              <div class="contact-text-image-cards__detail" {{ block.shopify_attributes }}>
                <div class="contact-text-image-cards__icon">
                  {% case block.settings.icon %}
                    {% when 'location' %}
