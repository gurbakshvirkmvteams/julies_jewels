{% comment %}
  Section: Contact Text Image Cards
  File: sections/contact-text-image-cards.liquid
{% endcomment %}

<section class="contact-text-image-cards">
  <div class="contact-text-image-cards__inner">

    <div class="contact-text-image-cards__content">

      {% if section.settings.heading != blank %}
        <h2 class="contact-text-image-cards__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="contact-text-image-cards__details">
        {% for block in section.blocks %}
          {% if block.type == 'contact_detail' %}
            <div
              class="contact-text-image-cards__detail"
              {{ block.shopify_attributes }}
            >
              <div class="contact-text-image-cards__icon">
                {% case block.settings.icon %}

                  {% when 'location' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 21s7-6.2 7-12A7 7 0 1 0 5 9c0 5.8 7 12 7 12Z"/>
                      <circle cx="12" cy="9" r="2.5"/>
                    </svg>

                  {% when 'phone' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6.6 3.5 9 3l2 5-2.2 1.8a15 15 0 0 0 5.4 5.4L16 13l5 2 .5 2.4c.2 1-.5 2-1.5 2.2C10.8 21 3 13.2 4.4 4.9c.2-1 .9-1.6 2.2-1.4Z"/>
                    </svg>

                  {% when 'email' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="14" rx="1.5"/>
                      <path d="m4 7 8 6 8-6"/>
                    </svg>

                  {% when 'clock' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 7v5l3 2"/>
                    </svg>

                {% endcase %}
              </div>

              <div class="contact-text-image-cards__text">
                {{ block.settings.text }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% assign social_blocks = section.blocks | where: 'type', 'social_icon' %}

      {% if social_blocks.size > 0 %}
        <div class="contact-text-image-cards__socials">
          {% for block in social_blocks %}
            {% if block.settings.url != blank %}
              <a
                href="{{ block.settings.url }}"
                class="contact-text-image-cards__social"
                target="_blank"
                rel="noopener"
                aria-label="{{ block.settings.platform | capitalize }}"
                {{ block.shopify_attributes }}
              >

                {% case block.settings.platform %}

                  {% when 'instagram' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"/>
                      <circle cx="12" cy="12" r="4"/>
                      <circle cx="17.5" cy="6.5" r="1"/>
                    </svg>

                  {% when 'facebook' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M13.5 8H15V5.5h-1.8C10.8 5.5 10 6.8 10 8.8V11H8v2.5h2V19h3v-5.5h2.2L15.5 11H13v-2c0-.7.2-1 1-1Z"/>
                    </svg>

                  {% when 'pinterest' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M10.5 18c.8-1.2 1-2.3 1.3-3.4.5 1 1.5 1.6 2.8 1.6 2.4 0 4.2-2.1 4.2-5.1 0-2.8-2.3-5.4-5.8-5.4-4.4 0-6.7 3.1-6.7 5.7 0 1.6.6 3 1.8 3.5.2.1.4 0 .5-.3l.4-1.3c.1-.3.1-.4-.1-.7-.4-.5-.7-1.2-.7-2.1 0-2.7 2-4.9 5.2-4.9 2.8 0 4.3 1.7 4.3 3.9 0 2.9-1.3 5.4-3.2 5.4-1.1 0-2-.9-1.7-2.1l.6-2.4c.4-1.5-.2-2.7-.2-3.7Z"/>
                    </svg>

                {% endcase %}

              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>

    <div class="contact-text-image-cards__image">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
    </div>

  </div>
</section>

<style>
  .contact-text-image-cards {
    background: #fff;
  }

  .contact-text-image-cards__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1400px;
    margin: 0 auto;
  }

  .contact-text-image-cards__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
  }

  .contact-text-image-cards__heading {
    margin: 0 0 32px;
    color: #444;
    font-size: 42px;
    line-height: 1.1;
    font-weight: 400;
  }

  .contact-text-image-cards__details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-text-image-cards__detail {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .contact-text-image-cards__icon {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  .contact-text-image-cards__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-text-image-cards__text {
    font-size: 13px;
    line-height: 1.6;
    color: #555;
  }

  .contact-text-image-cards__text p {
    margin: 0;
  }

  .contact-text-image-cards__socials {
    display: flex;
    gap: 20px;
    margin-top: 30px;
  }

  .contact-text-image-cards__social {
    width: 22px;
    height: 22px;
    color: #333;
  }

  .contact-text-image-cards__social svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-text-image-cards__image {
    min-height: 500px;
  }

  .contact-text-image-cards__image img,
  .contact-text-image-cards__image svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 500px;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .contact-text-image-cards__inner {
      grid-template-columns: 1fr;
    }

    .contact-text-image-cards__content {
      padding: 40px 20px;
    }

    .contact-text-image-cards__heading {
      font-size: 32px;
    }

    .contact-text-image-cards__image,
    .contact-text-image-cards__image img,
    .contact-text-image-cards__image svg {
      min-height: 400px;
    }
  }
</style>

{% schema %}
{
  "name": "Contact text image cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "contact_detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "location",
              "label": "Location"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "clock",
              "label": "Clock"
            }
          ],
          "default": "location"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Contact information</p>"
        }
      ]
    },
    {
      "type": "social_icon",
      "name": "Social icon",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact text image cards",
      "blocks": [
        {
          "type": "contact_detail",
          "settings": {
            "icon": "location",
            "text": "<p>301 Haywood Road, Suite 3<br>Greenville, South Carolina 29607</p>"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "phone",
            "text": "<p>Tel: (864) 288-9068</p>"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "email",
            "text": "<p>sales@example.com</p>"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "clock",
            "text": "<p>Mon - Fri: 10:00am - 5:30pm<br>Saturday: 10:00am - 3:00pm<br>Sunday: Closed</p>"
          }
        },
        {
          "type": "social_icon",
          "settings": {
            "platform": "instagram"
          }
        },
        {
          "type": "social_icon",
          "settings": {
            "platform": "facebook"
          }
        },
        {
          "type": "social_icon",
          "settings": {
            "platform": "pinterest"
          }
        }
      ]
    }
  ]
}
{% endschema %}