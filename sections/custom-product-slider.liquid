{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
<section id="product-slider-{{ section.id }}" class="product-slider-section page-width">
  <div class="product-slider-wrapper">
    {% if section.settings.heading != blank %}
      <div class="product-slider-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}
    <div class="product-slider-container">
      <!-- LEFT ARROW -->
      <button
        class="product-slider-arrow product-slider-prev"
        type="button"
        aria-label="Previous products">
        <svg
          width="10"
          height="18"
          viewBox="0 0 10 18"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M9 1L1 9L9 17"
            stroke="currentColor"
            stroke-width="1.2" />
        </svg>
      </button>
      <div class="swiper product-slider">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              <div class="swiper-slide product-slider-slide" {{ block.shopify_attributes }}>
                <div class="product-card">
                  <a href="{{ product.url }}" class="product-card-link">
                    <div class="product-image-wrapper">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'product-image', widths: '300, 400, 500, 600, 800'
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'product-image placeholder' }}
                      {% endif %}
                    </div>
                  </a>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <button
        class="product-slider-arrow product-slider-next"
        type="button"
        aria-label="Next products">
        <svg
          width="10"
          height="18"
          viewBox="0 0 10 18"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M1 1L9 9L1 17"
            stroke="currentColor"
            stroke-width="1.2" />
        </svg>
      </button>
    </div>
  </div>
</section>
<style>
  #product-slider-{{ section.id }} {
    --desktop-scale: 1;
    --slider-height: 328px;
    --arrow-size: 32px;
    --image-padding: 24px;
    width: 100%;
  }
  #product-slider-{{ section.id }}
  .product-slider-wrapper {
    width: 100%;
    margin: 0 auto;
    margin-top: clamp(20px, 5vw ,{{ section.settings.margin_top }}px) !important;
    margin-bottom:clamp(20px, 5vw ,{{ section.settings.margin_bottom }}px) !important;
  }
  #product-slider-{{ section.id }}
  .product-slider-heading {
    margin-bottom: calc(24px * var(--desktop-scale));
    text-align: center;
  }
  #product-slider-{{ section.id }}
  .product-slider-heading h2 {
    margin: 0;
    font-size: calc(32px * var(--desktop-scale));
    line-height: 1.2;
    font-weight: 400;
  }
  #product-slider-{{ section.id }}
  .product-slider-container {
    position: relative;
    width: 100%;
    height: calc(var(--slider-height) * var(--desktop-scale));
    /* border: 1px solid var(--card-border); */
    overflow: visible;
  }
  #product-slider-{{ section.id }}
  .product-slider {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  #product-slider-{{ section.id }}
  .swiper-wrapper {
    height: 100%;
  }
  #product-slider-{{ section.id }}
  .product-slider-slide {
    height: 100%;
    box-sizing: border-box;
  }
  #product-slider-{{ section.id }}.product-slider-slide:last-child {
    border-right: none;
  }
  #product-slider-{{ section.id }}
  .product-card {
    position: relative;
    width: 100%;
    height: 100%;
    background: #FAFAFA;
  }
  #product-slider-{{ section.id }}
  .product-card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }
  #product-slider-{{ section.id }}
  .product-image-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--image-padding) * var(--desktop-scale));
    box-sizing: border-box;
  }
  #product-slider-{{ section.id }}
  .product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    mix-blend-mode: multiply;
  }
  #product-slider-{{ section.id }}
  .product-wishlist {
    position: absolute;
    top: calc(14px * var(--desktop-scale));
    right: calc(14px * var(--desktop-scale));
    z-index: 5;
    width: calc(var(--arrow-size) * var(--desktop-scale));
    height: calc(var(--arrow-size) * var(--desktop-scale));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #777;
    cursor: pointer;
  }
  #product-slider-{{ section.id }}
  .product-slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: calc(var(--arrow-size) * var(--desktop-scale));
    height: calc(var(--arrow-size) * var(--desktop-scale));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #555;
    cursor: pointer;
  }
  #product-slider-{{ section.id }}
  .product-slider-prev {
    left: calc(-16px * var(--desktop-scale));
  }
  #product-slider-{{ section.id }}
  .product-slider-next {
    right: calc(-16px * var(--desktop-scale));
  }
  #product-slider-{{ section.id }}
  .product-slider-arrow svg {
    width: calc(10px * var(--desktop-scale));
    height: calc(18px * var(--desktop-scale));
  }
  #product-slider-{{ section.id }}
  .swiper-button-disabled {
    opacity: 0.25;
    cursor: default;
  }
  @media screen and (min-width: 1441px) {
    #product-slider-{{ section.id }} {
      --desktop-scale: 1.25;
    }
  }
  @media screen and (max-width: 1199px) {
    #product-slider-{{ section.id }} .product-slider-container {
      height: 280px;
    }
    #product-slider-{{ section.id }}
    .product-slider-slide {
      width: 25%;
    }
  }
@media screen and (max-width: 749px) {
  #product-slider-{{ section.id }} {
    --desktop-scale: 1;
  }
  #product-slider-{{ section.id }} .product-slider-wrapper {
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }
  #product-slider-{{ section.id }} .product-slider-container {
    height: 274px;
  }
  #product-slider-{{ section.id }} .product-slider {
    width: 100%;
    height: 274px;
    overflow: hidden;
  }
 
  #product-slider-{{ section.id }} .product-slider-slide {
    width: 274px !important;
    height: 274px !important;
    flex-shrink: 0;
  }
  #product-slider-{{ section.id }} .product-card {
    width: 274px;
    height: 274px;
  }
  #product-slider-{{ section.id }} .product-image-wrapper {
    width: 274px;
    height: 274px;
    padding: 24px;
    box-sizing: border-box;
  }
  #product-slider-{{ section.id }} .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #product-slider-{{ section.id }} .product-slider-arrow {
    width: 28px;
    height: 28px;
  }
  #product-slider-{{ section.id }} .product-slider-prev {
    left: -10px;
  }
  #product-slider-{{ section.id }} .product-slider-next {
    right: -10px;
  }
}
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sliderElement =
      document.querySelector(
        '#product-slider-{{ section.id }} .product-slider'
      );
    if (!sliderElement) return;
    new Swiper(sliderElement, {
      slidesPerView: 4,
      slidesPerGroup: 1,
     spaceBetween:
        window.innerWidth >= 1441
            ? {{ section.settings.gap }} * 1.25
            : {{ section.settings.gap }},
      speed: 500,
      loop: {{ section.settings.loop | json }},
      navigation: {
        nextEl:
          '#product-slider-{{ section.id }} .product-slider-next',
        prevEl:
          '#product-slider-{{ section.id }} .product-slider-prev'
      },
      breakpoints: {
        0: {
            slidesPerView: 'auto',
            slidesPerGroup: 1,
            centeredSlides: true
        },
        480: {
            slidesPerView: 'auto',
            slidesPerGroup: 1,
            centeredSlides: true
        },
        750: {
            slidesPerView: 3,
            slidesPerGroup: 1,
            centeredSlides: false
        },
        1200: {
            slidesPerView: 4,
            slidesPerGroup: 1,
            centeredSlides: false
        }
    }
    });
  });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('product-slider-{{ section.id }}');
    if (!header) return;
    function updateHeaderClass() {
        if (window.innerWidth < 1441) {
        header.classList.add('page-width');
        header.classList.remove('header-wide');
        } else {
        header.classList.remove('page-width');
        header.classList.add('header-wide');
        }
    }
    updateHeaderClass();
    window.addEventListener('resize', updateHeaderClass);
    });
</script>
{% schema %}
  {
    "name": "Product Slider",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Featured Products"
      },{
        "type": "range",
        "id": "margin_top",
        "label": "Section Margin Top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 10
      },{
        "type": "range",
        "id": "margin_bottom",
        "label": "Section Margin Bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 10
      },  {
        "type": "range",
        "id": "gap",
        "label": "Product gap",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 10
      }, {
        "type": "checkbox",
        "id": "loop",
        "label": "Enable infinite loop",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Slider",
        "blocks": [
          {
            "type": "product"
          }, {
            "type": "product"
          }, {
            "type": "product"
          }, {
            "type": "product"
          }
        ]
      }
    ]
  }
{% endschema %}