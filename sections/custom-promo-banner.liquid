{% style %}
  #birthstone-section--{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #birthstone-section--{{ section.id }} .birthstone-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #birthstone-section--{{ section.id }} .birthstone-item {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    align-items: center;
    gap: 60px;
    margin-bottom: 50px;
  }

  #birthstone-section--{{ section.id }} .birthstone-image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #birthstone-section--{{ section.id }} .birthstone-image {
    display: block;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
    height: auto;
    object-fit: contain;
  }

  #birthstone-section--{{ section.id }} .birthstone-content {
    border: 2px solid transparent;
  }

  #birthstone-section--{{ section.id }} .birthstone-heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
  }

  #birthstone-section--{{ section.id }} .birthstone-description {
    margin: 0;
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_font_size }}px;
    font-weight: {{ section.settings.description_weight }};
    line-height: 1.5;
  }

  #birthstone-section--{{ section.id }} .birthstone-description p {
    margin: 0 0 15px;
  }

  #birthstone-section--{{ section.id }} .birthstone-description p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #birthstone-section--{{ section.id }} {
      margin-top: {{ section.settings.mobile_margin_top }}px;
      margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
    }

    #birthstone-section--{{ section.id }} .birthstone-container {
      padding: 0 16px;
    }

    #birthstone-section--{{ section.id }} .birthstone-item {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      margin-bottom: 40px;
    }

    #birthstone-section--{{ section.id }} .birthstone-image-wrapper {
      width: 100%;
      order: 1;
    }

    #birthstone-section--{{ section.id }} .birthstone-content {
      width: 100%;
      order: 2;
    }

    #birthstone-section--{{ section.id }} .birthstone-image {
      max-width: {{ section.settings.mobile_image_width }}px;
      margin: 0 auto;
    }

    #birthstone-section--{{ section.id }} .birthstone-heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
      margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;
    }

    #birthstone-section--{{ section.id }} .birthstone-description {
      font-size: {{ section.settings.mobile_description_font_size }}px;
    }
  }
{% endstyle %}

<section id="birthstone-section--{{ section.id }}">
  <div class="birthstone-container">

    {% for block in section.blocks %}
      <div
        class="birthstone-item"
        id="birthstone-item--{{ section.id }}--{{ block.id }}"
        {{ block.shopify_attributes }}
      >

        <div class="birthstone-image-wrapper">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                class: 'birthstone-image',
                loading: 'lazy'
            }}
          {% endif %}
        </div>

        <div class="birthstone-content">

          {% if block.settings.heading != blank %}
            <h2 class="birthstone-heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="birthstone-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

        </div>

      </div>
    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "Birthstones",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Desktop margin top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Desktop margin bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_margin_top",
      "label": "Mobile margin top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_margin_bottom",
      "label": "Mobile margin bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Desktop image width",
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 350
    },
    {
      "type": "range",
      "id": "mobile_image_width",
      "label": "Mobile image width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 280
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop font size",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "label": "Mobile font size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Desktop heading bottom spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_heading_margin_bottom",
      "label": "Mobile heading bottom spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Desktop font size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_description_font_size",
      "label": "Mobile font size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "description_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    }
  ],

  "blocks": [
    {
      "type": "birthstone",
      "name": "Birthstone",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Birthstone image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "January: Garnet"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Enter the birthstone description here.</p>"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Birthstones",
      "blocks": [
        {
          "type": "birthstone"
        },
        {
          "type": "birthstone"
        },
        {
          "type": "birthstone"
        }
      ]
    }
  ]
}
{% endschema %}