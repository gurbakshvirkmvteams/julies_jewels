{% style %}
  #promo-banner--{{ section.id }} {
    --promo-scale: 1;
    --promo-overlap: clamp({{ section.settings.gradient_overlap_min_range }}%, 26vw, {{ section.settings.gradient_overlap_max_range }}%);
    padding-top: clamp(0px, {{ section.settings.padding_top | divided_by: 14.4 }}vw, calc({{ section.settings.padding_top }}px * var(--promo-scale)));
    padding-bottom: clamp(0px, {{ section.settings.padding_bottom | divided_by: 14.4 }}vw, calc({{ section.settings.padding_bottom }}px * var(--promo-scale)));
    margin-top: clamp(0px, {{ section.settings.section_margin_top | divided_by: 14.4 }}vw, calc({{ section.settings.section_margin_top }}px * var(--promo-scale)));
    margin-bottom: clamp(0px, {{ section.settings.section_margin_bottom | divided_by: 14.4 }}vw, calc({{ section.settings.section_margin_bottom }}px * var(--promo-scale)));
    
  }
  #promo-banner--{{ section.id }} {
  --promo-heading-color: {% if section.settings.text_color == 'light' %}#FFFFFF{% else %}rgba(var(--color-base-accent-1), 1){% endif %};
}
  @media screen and (min-width: 1441px) {
    #promo-banner--{{ section.id }} {
      --promo-scale: 1.25;
    }
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: clamp(280px, 100vw, calc(1440px * var(--promo-scale)));
    margin: 0 auto;
    background: {{ section.settings.banner_gradient }};
    overflow: hidden;
    aspect-ratio:2.70/1;
    max-height: clamp(
    350px,
    {{ section.settings.desktop_banner_height | divided_by: 14.4 }}vw,
    calc({{ section.settings.desktop_banner_height }}px * var(--promo-scale))
  );
  }
  #promo-banner--{{ section.id }}
  .promo-banner__text {
    order: 1;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__image {
    order: 2;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--image-first .promo-banner__image {
    order: 1;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--image-first .promo-banner__text {
    order: 2;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__image {
    position: relative;
    z-index: 1;
    flex: 0 0{{ section.settings.image_width }}%;
    width: {{ section.settings.image_width }}%;
    min-width: 0;
    overflow: hidden;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__text {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__text {
    justify-content: {% case section.settings.content_vertical_alignment %}
                      {% when 'top' %}flex-start
                      {% when 'bottom' %}flex-end
                      {% else %}center
                     {% endcase %};
    align-items: {% case section.settings.content_horizontal_alignment %}
                  {% when 'left' %}flex-start
                  {% when 'right' %}flex-end
                  {% else %}center
                 {% endcase %};
    text-align: {{ section.settings.text_alignment }};
  }
  #promo-banner--{{ section.id }}
  .promo-banner__text::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    width: calc(100% + var(--promo-overlap));
    pointer-events: none;
    opacity: 100;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--text-first .promo-banner__text::before {
    left: 0;
    background: linear-gradient(90deg,{{ section.settings.banner_gradient }} 0%,{{ section.settings.banner_gradient }} 65%,rgba(0, 0, 0, 0) {{ section.settings.gradient_spread }}%);
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--image-first .promo-banner__text::before {
    right: 0;
    background: linear-gradient(270deg,{{ section.settings.banner_gradient }} 0%,{{ section.settings.banner_gradient }} 60%,rgba(0, 0, 0, 0) {{ section.settings.gradient_spread }}%);
    }
  #promo-banner--{{ section.id }}
  .promo-banner__content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: clamp(260px, {{ section.settings.content_max_width | divided_by: 14.4 }}vw, calc({{ section.settings.content_max_width }}px * var(--promo-scale)));
  }
#promo-banner--{{ section.id }}
.promo-banner__logo {
  width: auto;
  max-width: clamp(40px, {{ section.settings.logo_max_width | divided_by: 14.4 }}vw, calc({{ section.settings.logo_max_width }}px * var(--promo-scale)));
  height: auto;
  width: 100%;
  margin-bottom: clamp(0px, {{ section.settings.logo_margin_bottom | divided_by: 14.4 }}vw, calc({{ section.settings.logo_margin_bottom }}px * var(--promo-scale)));
}
#promo-banner--{{ section.id }}
.promo-banner__heading {
  margin: 0 0 clamp(17px, {{ section.settings.heading_margin_bottom | divided_by: 14.4 }}vw, calc({{ section.settings.heading_margin_bottom }}px * var(--promo-scale)));
  /* color: rgba(var(--color-base-accent-1), 1)!important; */
  color: var(--promo-heading-color) !important;
  font-size: clamp(16px, 4vw, calc({{ section.settings.heading_font_size }} * var(--promo-scale)));
  line-height: 100%;
}
#promo-banner--{{ section.id }}
.promo-banner__heading p {
  margin: 0;
}
#promo-banner--{{ section.id }}
.promo-banner__description {
  margin: 0 0 clamp(32px, {{ section.settings.description_margin_bottom | divided_by: 14.4 }}vw, calc({{ section.settings.description_margin_bottom }}px * var(--promo-scale)));
  color: var(--promo-heading-color) !important;
  font-size: clamp(12px, 3vw, calc({{ section.settings.descripiton_font_size }} * var(--promo-scale)));
  line-height: clamp(16px, 2vw, 28px);
}
#promo-banner--{{ section.id }}
.promo-banner__description p {
  margin: 0;
}
#promo-banner--{{ section.id }}
.promo-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: clamp(0px, {{ section.settings.button_margin_top | divided_by: 14.4 }}vw, calc({{ section.settings.button_margin_top }}px * var(--promo-scale)));
  padding: clamp(14px, 3vw, calc(14px * var(--promo-scale))) clamp(24px, 3vw, calc(24px * var(--promo-scale)));
  background: linear-gradient(90deg, #51A197 17.86%, #66C5BA 89.29%);
  color: white;
  font-size: clamp(10px, 3vw, calc(14px * var(--promo-scale)));
  line-height: 1.2;
  text-decoration: none;
}
@media (max-width:990px){
  .promo-banner__description{
  letter-spacing:0;
  }
  .promo-banner__text{
    margin:0 10px  
  }
}
@media screen and (max-width: 749px) {
  #promo-banner--{{ section.id }} {
    padding-left: 0;
    padding-right: 0;
    margin-top: {{ section.settings.mobile_section_margin_top }}px;
    margin-bottom: {{ section.settings.mobile_section_margin_bottom }}px;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper {
    display: flex;
    flex-direction: {% if section.settings.mobile_layout == 'image-first' %}
      column
    {% else %}
    column-reverse
  {% endif %};
    max-width: none;
    width: 100%;
    max-height:100%;
    aspect-ratio:auto;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__image
  , #promo-banner--{{ section.id }}
  .promo-banner__wrapper--image-first .promo-banner__image {
    order: 1;
    width: 100%;
    flex: 0 0 auto;
    aspect-ratio: 1/1;
  }
  #promo-banner--{{ section.id }}
  .promo-banner__text {
    order: 2;
    padding: clamp(43px, 8vw, 78px) 0 clamp(54px, 8vw, 78px)!important;
    width: 100%;
    flex: 0 0 auto;
    min-height: auto;
    padding-top: 43px;
    padding-bottom: 54px;
    padding-left:20px;
    padding-right: 20px;
    text-align: center;
    align-items: center;
    margin:0px;  
}
 #promo-banner--{{ section.id }} .promo-banner__description{
  line-height:28px;
  letter-spacing:5%;
  }
{% if section.settings.mobile_gradient_enable %}
  #promo-banner--{{ section.id }}
  .promo-banner__text::before,
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--text-first .promo-banner__text::before,
  #promo-banner--{{ section.id }}
  .promo-banner__wrapper--image-first .promo-banner__text::before {
    content: "";
    position: absolute;
    top: -100px;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
      background: linear-gradient(360deg,{{ section.settings.banner_gradient }} 29%,  {{ section.settings.banner_gradient }} 79%, rgba(0, 0, 0, 0) 89%);
    opacity: 100;
  }
{% else %}
  #promo-banner--{{ section.id }}
  .promo-banner__text::before {
    display: none;
  }
{% endif %}
#promo-banner--{{ section.id }}
.promo-banner__content {
  max-width: 100%;
}
#promo-banner--{{ section.id }}
.promo-banner__heading {
  font-size: 32px;
}

#promo-banner--{{ section.id }}
.promo-banner__button {
  font-size: {{ section.settings.mobile_button_font_size }}px;
  padding-left: clamp(100px, 4vw, calc(24px * var(--promo-scale)));
  padding-right: clamp(100px, 4vw, calc(24px * var(--promo-scale)));
}
#promo-banner--{{ section.id }}
.promo-banner__logo {
  max-width: {{ section.settings.logo_max_width }}px;
}
}
@media screen and (max-width: 391px) {
  #promo-banner--{{ section.id }} .promo-banner__text {
    padding: clamp(20px, 12vw, 43px) 0 !important;
  }
}
{% endstyle %}
{% if section.settings.banner_image != blank %}
  <section id="promo-banner--{{ section.id }}" class="promo-banner-section">
    <div class="
        promo-banner__wrapper
        promo-banner__wrapper--{{ section.settings.desktop_layout }}
      ">
      <div class="promo-banner__text">
        <div class="promo-banner__content">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo | image_url: width: 800 | image_tag: class: 'promo-banner__logo', loading: 'lazy'
            }}
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="promo-banner__heading">
              {{ section.settings.heading }}
            </h1>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="promo-banner__description">
              {{ section.settings.description }}
            </div>
          {% endif %}
          {% if section.settings.button_text != blank and section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" class="promo-banner__button">
              {{ section.settings.button_text }}
              <svg
                width="19"
                height="10"
                viewBox="0 0 19 10"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M13.5441 0C13.4197 3.033e-05 13.2981 0.0371698 13.195 0.106667C13.0918 0.176164 13.0117 0.274858 12.965 0.390122C12.9182 0.505385 12.9069 0.631976 12.9325 0.753697C12.9581 0.875419 13.0195 0.986736 13.1087 1.07341L16.2084 4.17318H0.633902C0.551082 4.17201 0.468855 4.18731 0.392 4.21819C0.315145 4.24907 0.245194 4.29492 0.186213 4.35308C0.127232 4.41123 0.0803967 4.48053 0.0484294 4.55694C0.016462 4.63335 0 4.71535 0 4.79818C0 4.88101 0.016462 4.96301 0.0484294 5.03942C0.0803967 5.11583 0.127232 5.18512 0.186213 5.24328C0.245194 5.30143 0.315145 5.34728 0.392 5.37816C0.468855 5.40905 0.551082 5.42435 0.633902 5.42318H16.2084L13.1087 8.52295C13.0487 8.58054 13.0008 8.64952 12.9678 8.72585C12.9348 8.80218 12.9174 8.88433 12.9166 8.96748C12.9157 9.05063 12.9315 9.13311 12.9629 9.21009C12.9943 9.28708 13.0408 9.35702 13.0996 9.41582C13.1584 9.47462 13.2283 9.52109 13.3053 9.55252C13.3823 9.58395 13.4648 9.5997 13.5479 9.59886C13.6311 9.59801 13.7132 9.58059 13.7896 9.5476C13.8659 9.51461 13.9349 9.46672 13.9925 9.40674L18.1591 5.24007C18.2763 5.12286 18.3421 4.96391 18.3421 4.79818C18.3421 4.63245 18.2763 4.4735 18.1591 4.35628L13.9925 0.189616C13.9342 0.129622 13.8645 0.0819272 13.7875 0.049357C13.7105 0.0167869 13.6277 3.32453e-06 13.5441 0Z" fill="white" />
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
      <div class="promo-banner__image">
        {{
          section.settings.banner_image | image_url: width: 1800 | image_tag: class: 'promo-banner__image-element', loading: 'lazy', widths: '375, 550, 750, 1000, 1300, 1600, 1800'
        }}
      </div>
    </div>
  </section>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('promo-banner--{{ section.id }}');
    if (!header) return;
    function updateHeaderClass() {
      if (window.innerWidth < 1441) {
        header.classList.add('page-width');
        header.classList.remove('header-wide');
      } else {
        header.classList.remove('page-width');
        header.classList.add('header-wide');
      }
    }
    updateHeaderClass();
    window.addEventListener('resize', updateHeaderClass);
  });
</script>
