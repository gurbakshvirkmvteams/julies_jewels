{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
<section
  id="hero-slider-{{ section.id }}"
  class="hero-slider-section"
  style="        --header-desktop-scale: 1;"
  >
  <div class="hero-slider swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="
            hero-slide
            swiper-slide
            hero-slide--{{ block.settings.text_position }}
            hero-slide--text-{{ block.settings.text_alignment }}
          "
          {{ block.shopify_attributes }}
        >
          <div class="hero-slide__image">
            {% if block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 800, 1000, 1200, 1344, 1600, 1800, 2000, 2400',
                  sizes: '(min-width: 1450px) 1680px, (min-width: 750px) calc(100vw - 96px), 100vw',
                  class: 'hero-slide__desktop-image'
              }}
            {% endif %}
            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  class: 'hero-slide__mobile-image'
              }}
            {% elsif block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  class: 'hero-slide__mobile-image'
              }}
            {% endif %}
          </div>
          <div
            class="hero-slide__content"
            style="
              --content-width: clamp(calc({{ block.settings.content_width }}px / 1.25), 28vw , {{ block.settings.content_width }}px);
              --content-offset: clamp(calc({{ block.settings.content_offset }}px /1.25), 28vw, {{ block.settings.content_offset }}px);
              --heading-color: {{ block.settings.heading_color }};
              --heading-size: {{ block.settings.heading_size }}px;
              --heading-weight: {{ block.settings.heading_weight }};
              --heading-max-width: {{ block.settings.heading_max_width }}px;
              --heading-margin-bottom: {{ block.settings.heading_margin_bottom }}px;
              --description-color: {{ block.settings.description_color }};
              --description-size: {{ block.settings.description_size }}px;
              --description-weight: {{ block.settings.description_weight }};
              --description-max-width: {{ block.settings.description_max_width }}px;
              --description-margin-bottom: {{ block.settings.description_margin_bottom }}px;
              --button-background: {{ block.settings.button_background }};
              --button-color: {{ block.settings.button_color }};
              --button-border-color: {{ block.settings.button_border_color }};
              --button-radius: {{ block.settings.button_radius }}px;
              --button-width: {{ block.settings.button_width }}px;
              --button-height: {{ block.settings.button_height }}px;
              --button-font-size: {{ block.settings.button_font_size }}px;
              --button-font-weight: {{ block.settings.button_font_weight }};
              --button-padding-x: {{ block.settings.button_padding_x }}px;
              --button-padding-y: {{ block.settings.button_padding_y }}px;
              --gradient-color: {{ block.settings.gradient_color }};
              --gradient-opacity: {{ block.settings.gradient_opacity | divided_by: 100.0 }};
              --gradient-start: {{ block.settings.gradient_start }}%;
              --gradient-end: {{ block.settings.gradient_end }}%;
              --gradient-angle: {{ block.settings.gradient_angle }}deg;
              --slide-scale: {% if block.settings.enable_desktop_scaling %}1{% else %}1{% endif %};
            "
          >
            {% if block.settings.heading != blank %}
              <h2 class="hero-slide__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="hero-slide__description">
                {{ block.settings.description }}
              </div>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <a
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
                class="hero-slide__button"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="hero-slider__pagination swiper-pagination"></div>
  </div>
</section>
<style>
      #hero-slider-{{ section.id }} {
          width: 100%;
          margin-top:{{ section.settings.margin_top }}px;
          margin-bottom:{{ section.settings.margin_bottom }}px;

      }
      #hero-slider-{{ section.id }}
      .hero-slider {
          width: 100%;
          max-width: calc(1440px * var(--header-desktop-scale));
          margin: 0 auto;
          position: relative;
          overflow: hidden;
      }
      #hero-slider-{{ section.id }} .hero-slide {
          position: relative;
          width: 100%;
          aspect-ratio: 1440 / 696;
          overflow: hidden;
      }
       #hero-slider-{{ section.id }} .hero-slide__desktop-image{
        object-fit: contain;
       }
      #hero-slider-{{ section.id }} .hero-slide__image {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
      }
      #hero-slider-{{ section.id }}
      .hero-slide__desktop-image
      , #hero-slider-{{ section.id }}
      .hero-slide__mobile-image {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
      }
      #hero-slider-{{ section.id }}
      .hero-slide__mobile-image {
          display: none;
      }
      #hero-slider-{{ section.id }} .hero-slide__content {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          z-index: 2;
          width: min(calc(var(--content-width) * var(--header-desktop-scale)), 100%);
          padding-left: calc(var(--content-offset) * var(--header-desktop-scale));
          padding-right: calc(var(--content-offset) * var(--header-desktop-scale));
          display: flex;
          flex-direction: column;
      }
      /* LEFT */
      #hero-slider-{{ section.id }} .hero-slide--left .hero-slide__content {
          left: 0;
          align-items: flex-start;
      }
      /* CENTER */
      #hero-slider-{{ section.id }} .hero-slide--center .hero-slide__content {
          left: 50%;
          transform: translate(-50%, -50%);
          align-items: center;
      }
      /* RIGHT */
      #hero-slider-{{ section.id }} .hero-slide--right .hero-slide__content {
          right: 0;
          align-items: flex-end;
      }
      #hero-slider-{{ section.id }} .hero-slide--text-left .hero-slide__content {
                  align-items: flex-start;
      }
      #hero-slider-{{ section.id }}
      .hero-slide--text-center .hero-slide__content {
       align-items: center;
      }
      #hero-slider-{{ section.id }}
      .hero-slide--text-right .hero-slide__content {
           align-items: flex-end;
          right: 0;
      }
  #hero-slider-{{ section.id }} .hero-slide__heading {
    margin: 0 0 calc(var(--heading-margin-bottom) * var(--header-desktop-scale));
    max-width: calc(var(--heading-max-width) * var(--header-desktop-scale));
    font-size: calc(var(--heading-size) * var(--header-desktop-scale));
    line-height: 1.4;
    font-weight: var(--heading-weight);
    color: var(--heading-color);
  }
#hero-slider-{{ section.id }} .hero-slide__description {
    width: 100%;
    max-width: calc(
      var(--description-max-width) * var(--header-desktop-scale)
    );
    margin: 0 0 calc(
      var(--description-margin-bottom) * var(--header-desktop-scale)
    );
    font-size: calc(
      var(--description-size) * var(--header-desktop-scale)
    );
    line-height: 1.45;
    font-weight: var(--description-weight);
    color: var(--description-color);
}
#hero-slider-{{ section.id }} .hero-slide__description p {
    margin: 0;
}
#hero-slider-{{ section.id }} .hero-slide__button {
display: inline-flex;
align-items: center;
justify-content: center;
width   : min(
    calc(var(--button-width) * var(--header-desktop-scale)),
    100%
);
min-height: calc(
    var(--button-height) * var(--header-desktop-scale)
);
padding:
    calc(var(--button-padding-y) * var(--header-desktop-scale))
    calc(var(--button-padding-x) * var(--header-desktop-scale));
box-sizing: border-box;
background: var(--button-background);
color: var(--button-color);
border:
    calc(1px * var(--header-desktop-scale))
    solid
    var(--button-border-color);
border-radius: calc(
    var(--button-radius) * var(--header-desktop-scale)
);
text-decoration: none;
font-size: calc(
    var(--button-font-size) * var(--header-desktop-scale)
);
font-weight: var(--button-font-weight);
line-height: 1;
transition:
    background-color 0.2s ease,
    color 0.2s ease;
}
#hero-slider-{{ section.id }} .hero-slider__pagination {
    position: absolute;
    bottom: calc(45px * var(--header-desktop-scale));
    left: 0;
    width: 100%;
    z-index: 5;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: calc(5px * var(--header-desktop-scale));
}
#hero-slider-{{ section.id }}
.swiper-pagination-bullet {
    width: calc(5px * var(--header-desktop-scale));
    height: calc(5px * var(--header-desktop-scale));
    margin: 0 !important;
    background: #909396;
    opacity: .6;
}
#hero-slider-{{ section.id }}
.swiper-pagination-bullet-active {
    opacity: 1;
    background: #ffffff;

}
@media screen and (max-width: 749px) {
    #hero-slider-{{ section.id }} {
    --header-desktop-scale: 1;
    margin-top:0;
    margin-bottom:0;
    padding-left:0;
    padding-right:0;
    }
    #hero-slider-{{ section.id }} .hero-slider {
    width: 100%;
    max-width: none;
    margin: 0;
    overflow: hidden;
    }
    #hero-slider-{{ section.id }} .hero-slide {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    overflow: hidden;
    }
    #hero-slider-{{ section.id }} .hero-slide__image {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 298 / 192;
    flex-shrink: 0;
    z-index: 1;
    }
    #hero-slider-{{ section.id }}
    .hero-slide__desktop-image {
    display: none;
    }
    #hero-slider-{{ section.id }}
    .hero-slide__mobile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    }
    #hero-slider-{{ section.id }} .hero-slide__gradient {
    position: absolute;
    top: 25%;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 75%;
    z-index: 2;
    pointer-events: none;
    }
    #hero-slider-{{ section.id }} .hero-slide__content {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    transform: none !important;
    width: 100%;
    min-height: 207px;
    box-sizing: border-box;
    padding: 42px 34px 34px;
    margin-top: -40px;
    display: flex;
    flex-direction: column;
    justify-content: center !important;
    text-align: center !important;
    background: linear-gradient(var(--gradient-angle),transparent var(--gradient-start), var(--gradient-color) var(--gradient-end));
    z-index: 3;
    align-items: center !important;
    }
  
    #hero-slider-{{ section.id }} .hero-slide__heading {
    width: 100%;
    max-width: 260px;
    margin: 0 0 18px;
    font-size: 26px;
    line-height: 1.5;
    font-weight: 500;
    }
    #hero-slider-{{ section.id }} .hero-slide__description {
    width: 100%;
    max-width: 290px;
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.45;
    }
    #hero-slider-{{ section.id }}
    .hero-slide__description p {
    margin: 0;
    }
    #hero-slider-{{ section.id }} .hero-slide__button {
    width: clamp(322px, 5vw, 100%);
    max-width: 100%;
    min-height: 38px;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 500;
    }
    #hero-slider-{{ section.id }} .hero-slider__pagination {
    display: none;
    }
}
@media screen and (min-width: 1441px) {
#hero-slider-{{ section.id }} {
    --header-desktop-scale: 1.25 !important;
    }
  }
</style>
<script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener(
      'DOMContentLoaded',
      function () {
      const slider = document.querySelector(
          '#hero-slider-{{ section.id }} .hero-slider'
      );
      if (!slider) return;
      new Swiper(slider, {
          slidesPerView: 1,
          spaceBetween: 0,
          loop: {% if section.blocks.size > 1 %}true{% else %}false{% endif %},
          speed: 700,
        //  autoplay: {
        //  delay: 5000,
        //  disableOnInteraction: false
        //  },
          pagination: {
          el:
              '#hero-slider-{{ section.id }} .hero-slider__pagination',
          clickable: true
          },
          observer: true,
          observeParents: true
      });
      }
  );
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('hero-slider-{{ section.id }}');
      if (!header) return;
      function updateHeaderClass() {
        if (window.innerWidth < 1441) {
          header.classList.add('page-width');
          header.classList.remove('header-wide');
        } else {
          header.classList.remove('page-width');
          header.classList.add('header-wide');
        }
      }
      updateHeaderClass();
      window.addEventListener('resize', updateHeaderClass);
    });
  </script>
