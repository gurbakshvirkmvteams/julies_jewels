{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
<section id="hero-slider-{{ section.id }}" class="hero-slider-section header-wide" >
  <div class="hero-slider swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="hero-slide swiper-slide hero-slide--{{ block.settings.text_position }} hero-slide--text-{{ block.settings.text_alignment }}"
          {{ block.shopify_attributes }}
        >
          <div class="hero-slide__image">
            {% if block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 800, 1000, 1200, 1344, 1600, 1800, 2000, 2400',
                  sizes: '(min-width: 1450px) 1680px, (min-width: 750px) calc(100vw - 96px), 100vw',
                  class: 'hero-slide__desktop-image'
              }}
            {% endif %}
            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  class: 'hero-slide__mobile-image'
              }}
            {% elsif block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '100vw',
                  class: 'hero-slide__mobile-image'
              }}
            {% endif %}
          </div>
          <div
            class="hero-slide__content"
            style="
              --content-width: clamp(calc({{ block.settings.content_width }}px / 1.25), 28vw, {{ block.settings.content_width }}px);
              --content-offset: clamp(calc({{ block.settings.content_offset }}px / 1.45), 8vw, {{ block.settings.content_offset }}px);
              --heading-max-width: {{ block.settings.heading_max_width }}px;
              --description-max-width: clamp(calc({{ block.settings.description_max_width }} /1.05)px, 5vw, {{ block.settings.description_max_width }}px);
              --gradient-color: {{ block.settings.gradient_color }};
              --gradient-opacity: {{ block.settings.gradient_opacity | divided_by: 100.0 }};
              --gradient-start: {{ block.settings.gradient_start }}%;
              --gradient-end: {{ block.settings.gradient_end }}%;
            "
          >
            {% if block.settings.heading != blank %}
              <h2 class="hero-slide__heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="hero-slide__description">{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <a
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
                class="hero-slide__button"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="hero-slider__pagination swiper-pagination"></div>
  </div>
</section>
<style>
  :root{
    --header-desktop-scale: 1;
  }
   @media screen and (min-width: 1441px) {
    #hero-slider-{{ section.id }} {
      --header-desktop-scale: 1.25 ;
    }
  }
  #hero-slider-{{ section.id }} {
    width: 100%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  #hero-slider-{{ section.id }} .hero-slider {
    position: relative;
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    overflow: hidden;
  }
  #hero-slider-{{ section.id }} .hero-slide {
    position: relative;
    width: 100%;
    aspect-ratio:  2.24/1;
    overflow: hidden;
  }
  #hero-slider-{{ section.id }} .hero-slide__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #hero-slider-{{ section.id }} .hero-slide__desktop-image,
  #hero-slider-{{ section.id }} .hero-slide__mobile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #hero-slider-{{ section.id }} .hero-slide__desktop-image {
    object-fit: cover;
    aspect-ratio:  2.24/1;

  }
  #hero-slider-{{ section.id }} .hero-slide__mobile-image {
    display: none;
  }
  #hero-slider-{{ section.id }} .hero-slide__content {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(calc(var(--content-width) * var(--header-desktop-scale)), 100%);
    padding-left: calc(var(--content-offset) * var(--header-desktop-scale));
    padding-right: calc(var(--content-offset) * var(--header-desktop-scale));
  }
  #hero-slider-{{ section.id }} .hero-slide--left .hero-slide__content {
    left: 0;
    align-items: flex-start;
  }
  #hero-slider-{{ section.id }} .hero-slide--center .hero-slide__content {
    left: 50%;
    transform: translate(-50%, -50%);
    align-items: center;
  }
  #hero-slider-{{ section.id }} .hero-slide--right .hero-slide__content {
    right: 0;
    align-items: flex-end;
  }
  #hero-slider-{{ section.id }} .hero-slide--text-left .hero-slide__content {
    align-items: flex-start;
  }
  #hero-slider-{{ section.id }} .hero-slide--text-center .hero-slide__content {
    align-items: center;
  }
  #hero-slider-{{ section.id }} .hero-slide--text-right .hero-slide__content {
    align-items: flex-end;
  }
  #hero-slider-{{ section.id }} .hero-slide__heading {
    margin: 0 0 calc(18px * var(--header-desktop-scale));
    max-width: calc(var(--heading-max-width) * var(--header-desktop-scale));
    font-size: clamp(26px, 4vw, calc(36px * var(--header-desktop-scale)));
    line-height: clamp(100%, 3vw , 140%);
    color: rgba(var(--color-base-accent-1), 1) !important;
  }
  #hero-slider-{{ section.id }} .hero-slide__description {
    width: 100%;
    max-width: calc(var(--description-max-width) * var(--header-desktop-scale));
    margin: 0 0 calc(30px * var(--header-desktop-scale));
    font-size: calc(14px * var(--header-desktop-scale));
    line-height: 1.45;
    color: rgba(var(--color-base-accent-1), 1) !important;
  }
  #hero-slider-{{ section.id }} .hero-slide__description p {
    margin: 0;
  }
  #hero-slider-{{ section.id }} .hero-slide__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: min(calc(120px * var(--header-desktop-scale)), 100%);
    min-height: calc(47px * var(--header-desktop-scale));
    background-color: white;
    color: var(--border-bottom-hover);
    border: calc(1px * var(--header-desktop-scale)) solid var(--border-bottom-hover);
    font-size: calc(14px * var(--header-desktop-scale));
    font-weight: calc(var(--font-body-weight) + 100);
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  #hero-slider-{{ section.id }} .hero-slider__pagination {
    position: absolute;
    bottom: calc(45px * var(--header-desktop-scale));
    left: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: calc(5px * var(--header-desktop-scale));
  }
  #hero-slider-{{ section.id }} .swiper-pagination-bullet {
    width: calc(5px * var(--header-desktop-scale));
    height: calc(5px * var(--header-desktop-scale));
    margin: 0 !important;
    background: #909396;
    opacity: 0.6;
  }
  #hero-slider-{{ section.id }} .swiper-pagination-bullet-active {
    background: #ffffff;
    opacity: 1;
  }
  @media screen and (max-width: 749px) {
    #hero-slider-{{ section.id }} {
      --header-desktop-scale: 1;
      margin-top: 0;
      margin-bottom: 0;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    #hero-slider-{{ section.id }} .hero-slider {
      width: 100%;
      max-width: none;
      margin: 0;
      overflow: hidden;
    }
    #hero-slider-{{ section.id }} .hero-slide {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      overflow: hidden;
    }
    #hero-slider-{{ section.id }} .hero-slide__image {
      position: relative;
      z-index: 1;
      flex-shrink: 0;
      width: 100%;
      height: auto;
      aspect-ratio: 298 / 192;
    }
    #hero-slider-{{ section.id }} .hero-slide__desktop-image {
      display: none;
    }
    #hero-slider-{{ section.id }} .hero-slide__mobile-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    #hero-slider-{{ section.id }} .hero-slide__content {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      left: auto;
      transform: none !important;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box;
      width: 100%;
      min-height: 207px;
      margin-top: -40px;
      padding: 42px 34px 34px;
      background: linear-gradient(
        180deg,
        transparent var(--gradient-start),
        color-mix(in srgb, var(--gradient-color) calc(var(--gradient-opacity) * 100%), transparent) var(--gradient-end)
      );
      text-align: center !important;
    }
    #hero-slider-{{ section.id }} .hero-slide__heading {
      width: 100%;
      max-width: 260px;
      margin: 0 0 18px;
      font-size: 26px;
      font-weight: 500;
      line-height: 1.5;
    }
    #hero-slider-{{ section.id }} .hero-slide__description {
      width: 100%;
      max-width: 290px;
      margin: 0 0 22px;
      font-size: 14px;
      line-height: 1.45;
    }
    #hero-slider-{{ section.id }} .hero-slide__description p {
      margin: 0;
    }
    #hero-slider-{{ section.id }} .hero-slide__button {
      width: clamp(322px, 5vw, 100%);
      max-width: 100%;
      min-height: 38px;
      padding: 14px 20px;
      font-size: 14px;
      font-weight: 500;
    }
    #hero-slider-{{ section.id }} .hero-slider__pagination {
      display: none;
    }
  }
 
</style>
<script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.querySelector('#hero-slider-{{ section.id }} .hero-slider');
    if (!slider) return;
    new Swiper(slider, {
      slidesPerView: 1,
      spaceBetween: 0,
       autoplay: {
       delay: 5000,
       disableOnInteraction: false
       },
      loop: {% if section.blocks.size > 1 %}true{% else %}false{% endif %},
      speed: 700,
      pagination: {
        el: '#hero-slider-{{ section.id }} .hero-slider__pagination',
        clickable: true
      },
      observer: true,
      observeParents: true
    });
  });
</script>

{% schema %}
{
  "name": "Hero Slider Section",
  "settings": [
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image",
          "info": "Figma desktop image is based on 1440 × 696 at the 1440px design."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Content position"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position in slider",
          "default": "right",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "content_width",
          "label": "Content width",
          "min": 200,
          "max": 600,
          "step": 10,
          "unit": "px",
          "default": 360
        },
        {
          "type": "range",
          "id": "content_offset",
          "label": "Content side padding",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Where Greenville Gets Engaged!"
        },
        {
          "type": "range",
          "id": "heading_max_width",
          "label": "Heading max width",
          "min": 100,
          "max": 600,
          "step": 10,
          "unit": "px",
          "default": 500
        },
        {
          "type": "header",
          "content": "Description"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Choose the symbol designed for your love, to wear for the rest of your life</p>"
        },
        {
          "type": "range",
          "id": "description_max_width",
          "label": "Description max width",
          "min": 100,
          "max": 500,
          "step": 10,
          "unit": "px",
          "default": 320
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Gradient"
        },
        {
          "type": "color",
          "id": "gradient_color",
          "label": "Gradient color",
          "default": "#65C9C8"
        },
        {
          "type": "range",
          "id": "gradient_opacity",
          "label": "Gradient opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 90
        },
        {
          "type": "range",
          "id": "gradient_start",
          "label": "Transparent start",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "gradient_end",
          "label": "Color end",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider Section",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}