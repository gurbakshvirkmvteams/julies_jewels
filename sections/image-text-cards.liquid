  <section
    id="image-text-cards-{{ section.id }}"
    class="image-text-cards-section page-width"
  >
    <div class="image-text-cards__container">
      {% for block in section.blocks %}
        <div
          id="image-text-row-{{ section.id }}-{{ block.id }}"
          class="
            image-text-row
            image-text-row--{{ block.settings.desktop_layout }}
          "
          style="--mobile-card-height: {{ block.settings.mobile_card_height }}px;"
          {{ block.shopify_attributes }}
        >
          <!-- IMAGE / BANNER CARD -->
          <div
            class="image-text-card image-text-card--image"
            style="
              --image-position: {{ block.settings.image_position }};
              --image-fit: {{ block.settings.image_fit }};
            "
          >
            {% if block.settings.main_image != blank %}
              {{
                block.settings.main_image
                | image_url: width: 2000
                | image_tag: loading: 'lazy', class: 'image-text-card__main-image'
              }}
            {% else %}
              <div class="image-text-card__placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <!-- TEXT CARD -->
          <div
            class="image-text-card image-text-card--text"
            style="
              --text-bg: {{ block.settings.text_background }};
              --text-color: {{ block.settings.text_color }};
               --mobile-text-padding-top: {{ block.settings.mobile_text_padding_top }}px;
  --mobile-text-padding-bottom: {{ block.settings.mobile_text_padding_bottom }}px;
            "
          >
            <!-- TEXT CONTENT -->
            <div
              class="image-text-card__content"
              style="
                --text-bg: {{ block.settings.text_background }};
                --text-color: {{ block.settings.text_color }};
                --content-max-width: calc({{ block.settings.content_max_width }}px * var(--scale));
                --content-offset-x: {{ block.settings.content_offset_x }}px;
                --content-offset-y: {{ block.settings.content_offset_y }}px;
                --content-width: {{ block.settings.content_width }}%;
                text-align: {{ block.settings.text_alignment }};
              "
            >
              {% if block.settings.eyebrow != blank %}
                <div
                  class="image-text-card__eyebrow"
                  style="
                    --eyebrow-font: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
                    --eyebrow-size: {{ block.settings.eyebrow_size }}px;
                    --eyebrow-weight: {{ block.settings.eyebrow_weight }};
                    --eyebrow-line-height: {{ block.settings.eyebrow_line_height }};
                    --eyebrow-letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
                    --eyebrow-color: {{ block.settings.eyebrow_color }};
                    --eyebrow-transform: {{ block.settings.eyebrow_transform }};
                    --eyebrow-margin: {{ block.settings.eyebrow_margin }}px;
                  "
                >
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}
              {% if block.settings.heading != blank %}
                <div
                  class="image-text-card__heading"
                  style="
                    --heading-size: clamp(26px, 3.5vw,{{ block.settings.heading_size }}px);
                    --heading-weight: {{ block.settings.heading_weight }};
                    --heading-line-height: {{ block.settings.heading_line_height }};
                    --heading-letter-spacing: {{ block.settings.heading_letter_spacing }}px;
                    --heading-color: {{ block.settings.heading_color }};
                    --heading-transform: {{ block.settings.heading_transform }};
                    --heading-margin: {{ block.settings.heading_margin }}px;
                  "
                >
                  {{ block.settings.heading }}
                </div>
              {% endif %}
              {% if block.settings.description != blank %}
                <div
                  class="image-text-card__description"
                  style="
                    --description-size: {{ block.settings.description_size }}px;
                    --description-weight: {{ block.settings.description_weight }};
                    --description-line-height: {{ block.settings.description_line_height }};
                    --description-letter-spacing: {{ block.settings.description_letter_spacing }}px;
                    --description-color: {{ block.settings.description_color }};
                    --description-max-width: {{ block.settings.description_max_width }}px;
                    --description-margin: {{ block.settings.description_margin }}px;
                  "
                >
                  {{ block.settings.description }}
                </div>
              {% endif %}
              {% if block.settings.button_text != blank %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="image-text-card__button"
                  style="
                    --button-font: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
                    --button-width: {{ block.settings.button_width }}px;
                    --button-height: {{ block.settings.button_height }}px;
                    --button-padding-x: {{ block.settings.button_padding_x }}px;
                    --button-padding-y: {{ block.settings.button_padding_y }}px;
                    --button-border-width: {{ block.settings.button_border_width }}px;
                    --button-border-style: {{ block.settings.button_border_style }};
                    --button-radius: {{ block.settings.button_radius }}px;
                    --button-background: {{ block.settings.button_background }};
                    --button-text-color: {{ block.settings.button_text_color }};
                    --button-border-color: {{ block.settings.button_border_color }};
                    --button-font-size: {{ block.settings.button_font_size }}px;
                    --button-font-weight: {{ block.settings.button_font_weight }};
                    --button-letter-spacing: {{ block.settings.button_letter_spacing }}px;
                    --button-transform: {{ block.settings.button_transform }};
                    --button-hover-background: {{ block.settings.button_hover_background }};
                    --button-hover-text-color: {{ block.settings.button_hover_text_color }};
                    --button-hover-border-color: {{ block.settings.button_hover_border_color }};
                  "
                >
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
          <!-- DECORATIVE IMAGE 1 -->
          {% if block.settings.decorative_image_1 != blank %}
            <div
              class="decorative-image decorative-image--one"
              style="
                --decorative-width: {{ block.settings.decorative_image_1_width }}%;

                --desktop-left:
    {% if block.settings.decorative_image_1_horizontal == 'left' %}
      {{ block.settings.decorative_image_1_offset_x }}%
    {% elsif block.settings.decorative_image_1_horizontal == 'center' %}
      50%
    {% else %}
      auto
    {% endif %};

  --desktop-right:
    {% if block.settings.decorative_image_1_horizontal == 'right' %}
      {{ block.settings.decorative_image_1_offset_x }}%
    {% else %}
      auto
    {% endif %};

  --desktop-top:
    {% if block.settings.decorative_image_1_vertical == 'top' %}
      {{ block.settings.decorative_image_1_offset_y }}%
    {% elsif block.settings.decorative_image_1_vertical == 'center' %}
      50%
    {% else %}
      auto
    {% endif %};

  --desktop-bottom:
    {% if block.settings.decorative_image_1_vertical == 'bottom' %}
      {{ block.settings.decorative_image_1_offset_y }}%
    {% else %}
      auto
    {% endif %};

  --desktop-x:
    {% if block.settings.decorative_image_1_horizontal == 'center' %}
      calc(-50% + {{ block.settings.decorative_image_1_offset_x }}%)
    {% else %}
      0
    {% endif %};

  --desktop-y:
    {% if block.settings.decorative_image_1_vertical == 'center' %}
      calc(-50% + {{ block.settings.decorative_image_1_offset_y }}%)
    {% else %}
      0
    {% endif %};
  --mobile-left:
    {% if block.settings.decorative_image_1_mobile_horizontal == 'left' %}
      {{ block.settings.decorative_image_1_mobile_offset_x }}%
    {% elsif block.settings.decorative_image_1_mobile_horizontal == 'center' %}
      50%
    {% else %}
      auto
    {% endif %};

  --mobile-right:
    {% if block.settings.decorative_image_1_mobile_horizontal == 'right' %}
      {{ block.settings.decorative_image_1_mobile_offset_x }}%
    {% else %}
      auto
    {% endif %};

  --mobile-top:
    {% if block.settings.decorative_image_1_mobile_vertical == 'top' %}
      {{ block.settings.decorative_image_1_mobile_offset_y }}%
    {% elsif block.settings.decorative_image_1_mobile_vertical == 'center' %}
      50%
    {% else %}
      auto
    {% endif %};

  --mobile-bottom:
    {% if block.settings.decorative_image_1_mobile_vertical == 'bottom' %}
      {{ block.settings.decorative_image_1_mobile_offset_y }}%
    {% else %}
      auto
    {% endif %};

  --mobile-x:
    {% if block.settings.decorative_image_1_mobile_horizontal == 'center' %}
      calc(-50% + {{ block.settings.decorative_image_1_mobile_offset_x }}%)
    {% else %}
      0
    {% endif %};

  --mobile-y:
    {% if block.settings.decorative_image_1_mobile_vertical == 'center' %}
      calc(-50% + {{ block.settings.decorative_image_1_mobile_offset_y }}%)
    {% else %}
      0
    {% endif %};
              "
            >
              {{
                block.settings.decorative_image_1
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'decorative-image__img'
              }}
            </div>
          {% endif %}

          <!-- DECORATIVE IMAGE 2 -->
          {% if block.settings.decorative_image_2 != blank %}
            <div
              class="decorative-image decorative-image--two"
              style="
                --decorative-width: {{ block.settings.decorative_image_2_width }}%;

                --desktop-left:
                  {% if block.settings.decorative_image_2_horizontal == 'left' %}
                    {{ block.settings.decorative_image_2_offset_x }}%
                  {% else %}
                    auto
                  {% endif %};
                --desktop-right:
                  {% if block.settings.decorative_image_2_horizontal == 'right' %}
                    {{ block.settings.decorative_image_2_offset_x }}%
                  {% else %}
                    auto
                  {% endif %};
                --desktop-top:
                  {% if block.settings.decorative_image_2_vertical == 'top' %}
                    {{ block.settings.decorative_image_2_offset_y }}%
                  {% else %}
                    auto
                  {% endif %};
                --desktop-bottom:
                  {% if block.settings.decorative_image_2_vertical == 'bottom' %}
                    {{ block.settings.decorative_image_2_offset_y }}%
                  {% else %}
                    auto
                  {% endif %};
                --desktop-left-anchor:
                  {% if block.settings.decorative_image_2_horizontal == 'center' %}calc(50% + {{ block.settings.decorative_image_2_offset_x }}%){% else %}auto{% endif %};
                --desktop-x:
                  {% if block.settings.decorative_image_2_horizontal == 'center' %}calc(-50% + {{ block.settings.decorative_image_2_offset_x }}%){% else %}0{% endif %};
                --desktop-top-anchor:
                  {% if block.settings.decorative_image_2_vertical == 'center' %}calc(50% + {{ block.settings.decorative_image_2_offset_y }}%){% else %}auto{% endif %};
                --desktop-y:
                  {% if block.settings.decorative_image_2_vertical == 'center' %}calc(-50% + {{ block.settings.decorative_image_2_offset_y }}%){% else %}0{% endif %};

                --mobile-left:
                  {% if block.settings.decorative_image_2_mobile_horizontal == 'left' %}
                    {{ block.settings.decorative_image_2_mobile_offset_x }}%
                  {% else %}
                    auto
                  {% endif %};
                --mobile-right:
                  {% if block.settings.decorative_image_2_mobile_horizontal == 'right' %}
                    {{ block.settings.decorative_image_2_mobile_offset_x }}%
                  {% else %}
                    auto
                  {% endif %};
                --mobile-top:
                  {% if block.settings.decorative_image_2_mobile_vertical == 'top' %}
                    {{ block.settings.decorative_image_2_mobile_offset_y }}%
                  {% else %}
                    auto
                  {% endif %};
                --mobile-bottom:
                  {% if block.settings.decorative_image_2_mobile_vertical == 'bottom' %}
                    {{ block.settings.decorative_image_2_mobile_offset_y }}%
                  {% else %}
                    auto
                  {% endif %};
                --mobile-left-anchor:
                  {% if block.settings.decorative_image_2_mobile_horizontal == 'center' %}calc(50% + {{ block.settings.decorative_image_2_mobile_offset_x }}%){% else %}auto{% endif %};
                --mobile-x:
                  {% if block.settings.decorative_image_2_mobile_horizontal == 'center' %}-50%{% else %}0{% endif %};
                --mobile-top-anchor:
                  {% if block.settings.decorative_image_2_mobile_vertical == 'center' %}50%{% else %}auto{% endif %};
                --mobile-y:
                  {% if block.settings.decorative_image_2_mobile_vertical == 'center' %}-50%{% else %}0{% endif %};
              "
            >
              {{
                block.settings.decorative_image_2
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'decorative-image__img'
              }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
  <style>
    #image-text-cards-{{ section.id }} {
      /* --scale: 1; */
      --scale: clamp(1, calc(1 + (100vw - 1400px) / 2400px), 1.25);
      --section-width: {{ section.settings.section_width }}px;
      --card-height: clamp(400px, 45vw ,{{ section.settings.card_height }}px);
      --row-gap: {{ section.settings.row_gap }}px;
      --mobile-gap: {{ section.settings.mobile_gap }}px;

      width: 100%;
    }

    #image-text-cards-{{ section.id }} .image-text-cards__container {
      width: min(100%, calc(var(--section-width) * var(--scale)));
      margin: calc({{ section.settings.margin_top }}px * var(--scale)) auto
        calc({{ section.settings.margin_bottom }}px * var(--scale));
    }

    #image-text-cards-{{ section.id }} .image-text-row {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: calc(var(--row-gap) * var(--scale));
      margin-bottom: calc(var(--row-gap) * var(--scale));
      /* overflow: visible; */
      overflow: hidden;
    }

    #image-text-cards-{{ section.id }} .image-text-row--text-first {
      grid-template-areas: "text image";
    }

    #image-text-cards-{{ section.id }} .image-text-row--image-first {
      grid-template-areas: "image text";
    }

    #image-text-cards-{{ section.id }} .image-text-card {
      position: relative;
      min-width: 0;
    }

    #image-text-cards-{{ section.id }} .image-text-card--image {
      grid-area: image;
      height: calc(var(--card-height) * var(--scale));
      overflow: hidden;
      background: #f5f5f5;
    }

    #image-text-cards-{{ section.id }} .image-text-card__main-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: var(--image-fit);
      object-position: var(--image-position);
    }

    #image-text-cards-{{ section.id }} .image-text-card--text {
      grid-area: text;
      height: calc(var(--card-height) * var(--scale));
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
      background: var(--text-bg);
      color: var(--text-color);
    }

    #image-text-cards-{{ section.id }} .image-text-card__content {
      position: relative;
      z-index: 0;
      width: var(--content-width);
      max-width: calc(var(--content-max-width) * var(--scale));
      transform: translate(
        calc(var(--content-offset-x) * var(--scale)),
        calc(var(--content-offset-y) * var(--scale))
      );
    }

    #image-text-cards-{{ section.id }} .image-text-card__eyebrow {
      font-family: var(--eyebrow-font) !important;
      font-size: calc(var(--eyebrow-size) * var(--scale)) !important;
      font-weight: var(--eyebrow-weight) !important;
      line-height: var(--eyebrow-line-height) !important;
      letter-spacing: calc(var(--eyebrow-letter-spacing) * var(--scale)) !important;
      color: var(--eyebrow-color) !important;
      text-transform: var(--eyebrow-transform) !important;
      margin: 0 0 calc(var(--eyebrow-margin) * var(--scale)) !important;
    }
    #image-text-cards-{{ section.id }} .image-text-card__heading * {
          font-size: calc(var(--heading-size) * var(--scale)) !important;
          font-weight: var(--heading-weight) !important;
          line-height: calc(var(--heading-line-height) * var(--scale)) !important;
          letter-spacing: calc(var(--heading-letter-spacing) * var(--scale)) !important;
          color: var(--heading-color) !important;
          text-transform: var(--heading-transform) !important;
          margin: 0;
    }
    #image-text-cards-{{ section.id }} .image-text-card__heading {
      display: block !important;
      margin: 0 0 clamp(16px, 3vw, calc(var(--heading-margin) * var(--scale))) !important;
      padding: 0 !important;
    }

    #image-text-cards-{{ section.id }} .image-text-card__description {
      display: block !important;
      width: 100% !important;
      max-width: calc(var(--description-max-width) * var(--scale)) !important;
      margin: 0 0 calc(var(--description-margin) * var(--scale)) !important;
      padding: 0 !important;
      font-size: calc(var(--description-size) * var(--scale)) !important;
      font-weight: var(--description-weight) !important;
      line-height: var(--description-line-height) !important;
      letter-spacing: calc(var(--description-letter-spacing) * var(--scale)) !important;
      color: var(--description-color) !important;
    }

    #image-text-cards-{{ section.id }} .image-text-card__description p {
      margin: 0 !important;
      padding: 0 !important;
      font: inherit !important;
      color: inherit !important;
    }

    #image-text-cards-{{ section.id }} .image-text-card__button {
      position: relative;
      z-index: 1;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box;
      width: calc(var(--button-width) * var(--scale)) !important;
      min-width: calc(var(--button-width) * var(--scale)) !important;
      height: calc(var(--button-height) * var(--scale)) !important;
      min-height: calc(var(--button-height) * var(--scale)) !important;
      padding:
        calc(var(--button-padding-y) * var(--scale))
        calc(var(--button-padding-x) * var(--scale)) !important;
      border:
        calc(var(--button-border-width) * var(--scale))
        var(--button-border-style)
        var(--button-border-color) !important;
      border-radius: calc(var(--button-radius) * var(--scale)) !important;
      background: var(--button-background) !important;
      color: var(--button-text-color) !important;
      font-family: var(--button-font) !important;
      font-size: calc(var(--button-font-size) * var(--scale)) !important;
      font-weight: var(--button-font-weight) !important;
      line-height: 1 !important;
      letter-spacing: calc(var(--button-letter-spacing) * var(--scale)) !important;
      text-transform: var(--button-transform) !important;
      text-decoration: none !important;
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        opacity 0.2s ease !important;
    }

    #image-text-cards-{{ section.id }} .image-text-card__button:hover {
      background: var(--button-hover-background) !important;
      color: var(--button-hover-text-color) !important;
      border-color: var(--button-hover-border-color) !important;
    }

    #image-text-cards-{{ section.id }} .decorative-image {
      position: absolute;
      z-index: 2;
      pointer-events: none;
      width: var(--decorative-width);
      max-width: none;
      left: var(--desktop-left-anchor, var(--desktop-left));
      right: var(--desktop-right);
      top: var(--desktop-top-anchor, var(--desktop-top));
      bottom: var(--desktop-bottom);
      transform: translate(var(--desktop-x), var(--desktop-y));
    }

    #image-text-cards-{{ section.id }} .decorative-image__img {
      display: block;
      width: 100%;
      height: auto;
    }

    #image-text-cards-{{ section.id }} .image-text-card__placeholder,
    #image-text-cards-{{ section.id }} .image-text-card__placeholder svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    @media screen and (min-width: 1441px) {
      #image-text-cards-{{ section.id }} {
        /* --scale: 1.25; */
            --desktop-top: 0%;
      }
    }

    @media screen and (max-width: 749px) {
      #image-text-cards-{{ section.id }}{
        padding-left: 0;
        padding-right: 0;
      }
      #image-text-cards-{{ section.id }} .image-text-row {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin-bottom: var(--mobile-gap);
      }

      #image-text-cards-{{ section.id }} .image-text-card--image {
        order: 1;
        width: 100%;
        height: var(--mobile-card-height);
        min-height: var(--mobile-card-height);
        flex: 0 0 auto;
      }

      #image-text-cards-{{ section.id }} .image-text-card--text {
        order: 2;
        width: 100%;
        height: auto;
        min-height: 0;
         padding-top: var(--mobile-text-padding-top);
    padding-bottom: var(--mobile-text-padding-bottom);
        box-sizing: border-box;
      }
      #image-text-cards-{{ section.id }} .image-text-card__description {
            margin-bottom: 28px !important;
            margin-left: auto!important;
            margin-right: auto!important;
      }
      #image-text-cards-{{ section.id }} .image-text-card__button {
        min-width:322px !important ;
      }
      #image-text-cards-{{ section.id }} .image-text-card__heading {
            margin-bottom: clamp(21px, 5vw, calc(var(--heading-margin) * var(--scale))) !important;
          }
      #image-text-cards-{{ section.id }} .image-text-card__content {
        /* width: var(--content-width); */
        width: 100%;
        max-width: 100%;
        flex-shrink: 0;
        transform: none;
            text-align: center !important;
      }
      #image-text-cards-{{ section.id }} .decorative-image {
        width: min(calc(var(--decorative-width) * 1.9), 50%);

        left: var(--mobile-left);
        right: var(--mobile-right);
        top: var(--mobile-top);
        bottom: var(--mobile-bottom);

        transform: translate(
          var(--mobile-x),
          var(--mobile-y)
        );
      }
    }
    @media (max-width:460px){
      #image-text-cards-{{ section.id }} .image-text-card.image-text-card--text{
        padding-left:10px ;
        padding-right:10px;
      }
      #image-text-cards-{{ section.id }} .image-text-card__description p{
          letter-spacing: 0px !important;
          font-size: clamp(12px , 4vw , 16px) !important;
        }
    }
    @media (max-width:350px){
      #image-text-cards-{{ section.id }} .image-text-card__button {
        min-width:auto !important ;
      }
    }
    #image-text-cards-{{ section.id }}.header-wide {
      max-width: 1920px;
      margin-left: auto;
      margin-right: auto;
      padding-left: clamp(40px, 3vw, 120px);
      padding-right: clamp(40px, 3vw, 120px);
      box-sizing: border-box;
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('image-text-cards-{{ section.id }}');
      if (!header) return;
      function updateHeaderClass() {
        if (window.innerWidth < 1441) {
          header.classList.add('page-width');
          header.classList.remove('header-wide');
        } else {
          header.classList.remove('page-width');
          header.classList.add('header-wide');
        }
      }
      updateHeaderClass();
      window.addEventListener('resize', updateHeaderClass);
    });
  </script>
  {% schema %}
  {
    "name": "Image Text Cards",
    "settings": [
      {
        "type": "range",
        "id": "section_width",
        "label": "Section width",
        "min": 800,
        "max": 1800,
        "step": 20,
        "default": 1400,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "card_height",
        "label": "Desktop card height",
        "min": 300,
        "max": 800,
        "step": 10,
        "default": 670,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "row_gap",
        "label": "Desktop row gap",
