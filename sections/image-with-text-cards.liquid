{% style %}
  #image_text_cards--{{ section.id }} {
    --cards-gap: {{ section.settings.gap }}px;
    margin-top:{{ section.settings.margin_top }}px;
    margin-bottom:{{ section.settings.margin_bottom }}px;
  }
  #image_text_cards--{{ section.id }} .image-with-text-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--cards-gap);
  }
  #image_text_cards--{{ section.id }} .image-with-text-card {
    position: relative;
    display: flex;
    /* aspect-ratio: {{ section.blocks.first.settings.card_ratio_width }} / {{ section.blocks.first.settings.card_ratio_height }}; */
    /* border-radius: {{ section.blocks.first.settings.card_radius }}px; */
    background-image:  url('{{ section.blocks.settings.background_image | image_url: width: 1600 }}');
    background-size: cover;
    background-position: center;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__content {
    position: relative;
     min-height: clamp(320px, 40vw, 384px);
    z-index: 2;
    width: 100%;
    max-width: {{ section.blocks.first.settings.content_width }}%;
    padding: clamp(20px, 3.33vw, {{ section.blocks.first.settings.content_padding }}px);
    display: flex;
    flex-direction: column;
    {% case section.blocks.first.settings.content_vertical %}
      {% when 'top' %}
        justify-content: flex-start;
      {% when 'center' %}
        justify-content: center;
      {% when 'bottom' %}
        justify-content: flex-end;
    {% endcase %}
    {% case section.blocks.first.settings.content_horizontal %}
      {% when 'left' %}
        margin-right: auto;
        margin-left: 0;
      {% when 'center' %}
        margin-left: auto;
        margin-right: auto;
      {% when 'right' %}
        margin-left: auto;
        margin-right: 0;
    {% endcase %}
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__logo {
    margin-bottom: clamp(8px, 1vw, {{ section.blocks.first.settings.logo_margin_bottom }}px);
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__logo img {
    display: block;
     width: var(--logo-width);
    max-width: 100%;
    height: auto;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__heading {
    margin: 0 0 clamp(8px, 1vw, {{ section.blocks.first.settings.heading_margin_bottom }}px);
    font-size: clamp(22px, 3vw, 36px);
    /* font-weight: {{ section.blocks.first.settings.heading_weight }};
    line-height: {{ section.blocks.first.settings.heading_line_height }}; */
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__description {
    margin: 0 0 clamp(12px, 1.3vw, {{ section.blocks.first.settings.description_margin_bottom }}px);
    font-size: clamp(11px, 1.05vw, 14px);
    font-weight: 500;
    line-height: 100%;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__description p {
    margin: 0;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: clamp(6px, 0.55vw, 10px);
    padding: clamp(8px, 0.7vw, 14px) clamp(12px, 1.3vw, 24px);
   color: rgba(var(--color-foreground), 1);
    background: linear-gradient(90deg, #51A197 17.86%, #66C5BA 89.29%);
    font-size: clamp(10px, 0.9vw, 14px);
    font-weight:700;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__button:hover {
    opacity: 0.85;
  }
  #image_text_cards--{{ section.id }} .image-with-text-card__button svg {
    display: block;
    flex-shrink: 0;
    height: auto;
  }
  @media (max-width:1000px){
 #image_text_cards--{{ section.id }} .image-with-text-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  @media screen and (max-width: 749px) {
    #image_text_cards--{{ section.id }} {
        padding-left:0px;
        padding-right:0px;
    }
    #image_text_cards--{{ section.id }} .image-with-text-card {
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__content {
      max-width: {{ section.blocks.first.settings.mobile_content_width }}% !important;
      width:100%;
      padding: clamp(16px, 5vw, {{ section.blocks.first.settings.mobile_content_padding }}px);
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__logo {
        margin-bottom: var(--logo-margin-bottom);
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__logo img {
         width: var(--logo-width);
    max-width: 100%;
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__heading {
      margin-bottom: clamp(6px, 2vw, {{ section.blocks.first.settings.mobile_heading_margin_bottom }}px);
      font-size: clamp(20px, 7vw, {{ section.blocks.first.settings.heading_size }}px);
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__description {
      margin-bottom: clamp(10px, 3vw, {{ section.blocks.first.settings.mobile_description_margin_bottom }}px);
      font-size: clamp(12px, 3.5vw, 14px);
    }
    #image_text_cards--{{ section.id }} .image-with-text-card__button {
      gap: clamp(5px, 2vw, 10px);
      padding: clamp(7px, 2.5vw, 14px) clamp(12px, 5vw, 24px);
      font-size: clamp(10px, 3.2vw, 14px);
    }
  }
{% endstyle %}
<section id="image_text_cards--{{ section.id }}" class="image-with-text-cards">
  <div class="image-with-text-cards-grid">
    {% for block in section.blocks %}
      <div
        class="image-with-text-card"
        style="
          background-image: url('{{ block.settings.background_image | image_url: width: 1600 }}');
          background-position: center center;
        "
        {{ block.shopify_attributes }}
      >
        <div
          class="image-with-text-card__content"
          style="
            max-width: {{ block.settings.content_width }}%;
            {% if block.settings.content_horizontal == 'left' %}
              margin-left: 0;
              margin-right: auto;
            {% elsif block.settings.content_horizontal == 'center' %}
              margin-left: auto;
              margin-right: auto;
            {% elsif block.settings.content_horizontal == 'right' %}
              margin-left: auto;
              margin-right: 0;
            {% endif %}
            {% if block.settings.content_vertical == 'top' %}
              align-self: flex-start;
            {% elsif block.settings.content_vertical == 'center' %}
              align-self: center;
            {% elsif block.settings.content_vertical == 'bottom' %}
              align-self: flex-end;
            {% endif %}
          "
        >
          {% if block.settings.logo != blank %}
            <div
              class="image-with-text-card__logo"
               style="
                  --logo-width: clamp(100px, 60vw, {{ block.settings.logo_width }}px);
                  --logo-margin-bottom: {{ block.settings.logo_margin_bottom }}px;
                "
            >
              {{ block.settings.logo | image_url: width: 500 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2
              class="image-with-text-card__heading"
              style="
                  color: {% if block.settings.text_color_mode == 'dark' %}#000000{% else %}rgba(var(--color-foreground), 1){% endif %};
                font-size: clamp(22px, 3vw, 36px);
                /* font-weight: {{ block.settings.heading_weight }};
                line-height: {{ block.settings.heading_line_height }}; */
                margin-bottom: clamp(8px, 1vw, {{ block.settings.heading_margin_bottom }}px);
              "
            >
              {{ block.settings.heading }}
            </h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <div
              class="image-with-text-card__description"
              style="
                color: {% if block.settings.text_color_mode == 'dark' %}#000000{% else %}white{% endif %};

                font-size: clamp(12px, 1.1vw, 14px);
                font-weight: 500;
                line-height: 1.4;
                margin-bottom: clamp(12px, 2.5vw, {{ block.settings.description_margin_bottom }}px);
              "
            >
              {{ block.settings.description }}
            </div>
          {% endif %}
          {% if block.settings.button_text != blank and block.settings.button_link != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="image-with-text-card__button"
              style="
               color: white;
                background: linear-gradient(90deg, #51A197 17.86%, #66C5BA 89.29%);
                font-size: clamp(10px, 0.9vw, 14px);
                font-weight: 700;
                padding: clamp(8px, 0.7vw, 14px) clamp(12px, 1.3vw, 24px);
                gap: clamp(6px, 0.55vw, 10px);
              "
            >
              {{ block.settings.button_text }}
              <svg width="19" height="10" viewBox="0 0 19 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M13.5441 0C13.4197 3.033e-05 13.2981 0.0371698 13.195 0.106667C13.0918 0.176164 13.0117 0.274858 12.965 0.390122C12.9182 0.505385 12.9069 0.631976 12.9325 0.753697C12.9581 0.875419 13.0195 0.986736 13.1087 1.07341L16.2084 4.17318H0.633902C0.551082 4.17201 0.468855 4.18731 0.392 4.21819C0.315145 4.24907 0.245194 4.29492 0.186213 4.35308C0.127232 4.41123 0.0803967 4.48053 0.0484294 4.55694C0.016462 4.63335 0 4.71535 0 4.79818C0 4.88101 0.016462 4.96301 0.0484294 5.03942C0.0803967 5.11583 0.127232 5.18512 0.186213 5.24328C0.245194 5.30143 0.315145 5.34728 0.392 5.37816C0.468855 5.40905 0.551082 5.42435 0.633902 5.42318H16.2084L13.1087 8.52295C13.0487 8.58054 13.0008 8.64952 12.9678 8.72585C12.9348 8.80218 12.9174 8.88433 12.9166 8.96748C12.9157 9.05063 12.9315 9.13311 12.9629 9.21009C12.9943 9.28708 13.0408 9.35702 13.0996 9.41582C13.1584 9.47462 13.2283 9.52109 13.3053 9.55252C13.3823 9.58395 13.4648 9.5997 13.5479 9.59886C13.6311 9.59801 13.7132 9.58059 13.7896 9.5476C13.8659 9.51461 13.9349 9.46672 13.9925 9.40674L18.1591 5.24007C18.2763 5.12286 18.3421 4.96391 18.3421 4.79818C18.3421 4.63245 18.2763 4.4735 18.1591 4.35628L13.9925 0.189616C13.9342 0.129622 13.8645 0.0819272 13.7875 0.049357C13.7105 0.0167869 13.6277 0.00000332453 13.5441 0Z"
                  fill="white"
                />
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('image_text_cards--{{ section.id }}');
    if (!section) return;
    function updateSectionClass() {
      if (window.innerWidth < 1441) {
        section.classList.add('page-width');
        section.classList.remove('header-wide');
      } else {
        section.classList.remove('page-width');
        section.classList.add('header-wide');
      }
    }
    updateSectionClass();
    window.addEventListener('resize', updateSectionClass);
  });
</script>
{% schema %}
{
  "name": "Text Cards",
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "header", "content": "Card" },
        { "type": "image_picker", "id": "background_image", "label": "Background Image" },
        { "type": "header", "content": "Content Position" },
        {
          "type": "select",
          "id": "content_horizontal",
          "label": "Horizontal Position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "content_vertical",
          "label": "Vertical Position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "content_width",
          "label": "Content Width",
          "min": 20,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 55
        },
        {
          "type": "range",
          "id": "content_padding",
          "label": "Content Padding",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "mobile_content_width",
          "label": "Mobile Content Width",
          "min": 20,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 80
        },
        {
          "type": "range",
          "id": "mobile_content_padding",
          "label": "Mobile Content Padding",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        { "type": "header", "content": "Logo" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo Width",
          "min": 20,
          "max": 400,
          "step": 4,
          "unit": "px",
          "default": 160
        },
        {
          "type": "range",
          "id": "logo_margin_bottom",
          "label": "Logo Bottom Margin",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "mobile_logo_width",
          "label": "Mobile Logo Width",
          "min": 20,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 100
        },
        {
          "type": "range",
          "id": "mobile_logo_margin_bottom",
          "label": "Mobile Logo Bottom Margin",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        { "type": "header", "content": "Heading" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Card Heading" },
        {
          "type": "range",
          "id": "heading_margin_bottom",
          "label": "Heading Bottom Margin",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "mobile_heading_margin_bottom",
          "label": "Mobile Heading Bottom Margin",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 10
        },
        { "type": "header", "content": "Description" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Card description.</p>" },
        {
          "type": "range",
          "id": "description_margin_bottom",
          "label": "Description Bottom Margin",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "mobile_description_margin_bottom",
          "label": "Mobile Description Bottom Margin",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 18
        },{
          "type": "select",
          "id": "text_color_mode",
          "label": "Text Color",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        { "type": "header", "content": "Button" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Know More" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Cards",
      "blocks": [
        { "type": "card", "settings": { "heading": "Watch Repair" } },
        { "type": "card", "settings": { "heading": "Diamond Buying" } }
      ]
    }
  ]
}
{% endschema %}