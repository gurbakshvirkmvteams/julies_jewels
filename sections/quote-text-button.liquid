<section
  class="quote-section"
  style="
    --quote-bg: {{ section.settings.background_color }};
    --quote-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
  "
>
  <div class="quote-section__inner">

    {% if section.settings.quote_mark %}
      <div class="quote-section__mark">
        
<svg width="67" height="53" viewBox="0 0 67 53" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M50.4 -0.000110149C53.4666 -0.000110149 56 0.59989 58 1.79989C60 2.99989 61.6666 4.59989 63 6.5999C64.4666 8.73323 65.4 11.1332 65.8 13.7999C66.3333 16.4666 66.6 18.8666 66.6 20.9999C66.6 27.5332 64.9333 33.5332 61.6 38.9999C58.2666 44.4666 53.0666 48.8666 46 52.1999L44.2 48.5999C48.2 46.8666 51.6666 44.1999 54.6 40.5999C57.5333 36.9999 59.1333 33.3332 59.4 29.5999C59.5333 27.5999 59.4 25.7332 59 23.9999C56.6 26.2666 53.6666 27.3999 50.2 27.3999C46.3333 27.3999 43.0666 26.1999 40.4 23.7999C37.7333 21.3999 36.4 18.0666 36.4 13.7999C36.4 9.66656 37.7333 6.33323 40.4 3.7999C43.2 1.26656 46.5333 -0.000110149 50.4 -0.000110149ZM14 -0.000110149C17.0666 -0.000110149 19.6 0.59989 21.6 1.79989C23.6 2.99989 25.2666 4.59989 26.6 6.5999C28.0666 8.73323 29 11.1332 29.4 13.7999C29.9333 16.4666 30.2 18.8666 30.2 20.9999C30.2 27.5332 28.5333 33.5332 25.2 38.9999C21.8666 44.4666 16.6666 48.8666 9.59995 52.1999L7.79995 48.5999C11.8 46.8666 15.2666 44.1999 18.2 40.5999C21.1333 36.9999 22.7333 33.3332 23 29.5999C23.1333 27.5999 23 25.7332 22.6 23.9999C20.2 26.2666 17.2666 27.3999 13.8 27.3999C9.93329 27.3999 6.66662 26.1999 3.99995 23.7999C1.33329 21.3999 -4.83394e-05 18.0666 -4.83394e-05 13.7999C-4.83394e-05 9.66656 1.33329 6.33323 3.99995 3.7999C6.79995 1.26656 10.1333 -0.000110149 14 -0.000110149Z" fill="#66C5BA"/>
</svg>

      </div>
    {% endif %}

    {% if section.settings.quote != blank %}
      <div class="quote-section__text quote-section__text--{{ section.settings.text_size }}">
  {{ section.settings.quote }}
</div>
    {% endif %}

    {% if section.settings.author != blank %}
      <div class="quote-section__author">
        {{ section.settings.author }}
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'button' %}
          <div
            class="quote-section__button-wrapper"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.button_label != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="quote-section__button"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>

      {% endcase %}
    {% endfor %}

  </div>
</section>

<style>
  .quote-section {
    background: var(--quote-bg);
    color: var(--quote-color);
    width: 100%;
  }

  .quote-section__inner {
    max-width: 1420px;
    margin: 0 auto;
    text-align: center;
    padding: 78px 40px 0;
  }

  .quote-section__mark {
    color: var(--accent-color);
    font-family: Georgia, serif;
    font-size: 105px;
    line-height: 0.7;
    height: 75px;
    margin-bottom: 35px;
  }

  .quote-section__text {
  max-width: 720px;
  margin: 0 auto;
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.32;
  letter-spacing: -0.5px;
}

/* Quote text sizes */
.quote-section__text--small {
  font-size: 30px;
}

.quote-section__text--medium {
  font-size: 38px;
}

.quote-section__text--large {
  font-size: 46px;
}

  .quote-section__author {
    margin-top: 0px;
    font-family: Arial, sans-serif;
    font-size: 23px;
    line-height: 1.3;
  }

  .quote-section__button-wrapper {
    margin-top: 35px;
  }

  .quote-section__button {
    display: inline-block;
    padding: 15px 32px;
    background: var(--accent-color);
    color: #fff;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 15px;
    transition: opacity 0.2s ease;
  }

  .quote-section__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 749px) {
    .quote-section__inner {
    padding: 65px 20px 0;
  }

  .quote-section__mark {
    font-size: 75px;
    height: 55px;
    margin-bottom: 25px;
  }

  .quote-section__text--small {
    font-size: 24px;
  }

  .quote-section__text--medium {
    font-size: 28px;
  }

  .quote-section__text--large {
    font-size: 34px;
  }

  .quote-section__author {
    margin-top: 35px;
    font-size: 18px;
  } 
  }
</style>

{% schema %}
{
  "name": "Quote with button",
  "settings": [
    {
      "type": "checkbox",
      "id": "quote_mark",
      "label": "Show quotation mark",
      "default": true
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>We make a living by what we get;<br>We make a life by what we give.</p>"
    },
    {
  "type": "select",
  "id": "text_size",
  "label": "Quote text size",
  "options": [
    {
      "value": "small",
      "label": "Small"
    },
    {
      "value": "medium",
      "label": "Medium"
    },
    {
      "value": "large",
      "label": "Large"
    }
  ],
  "default": "medium"
},
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Winston Churchill"
    },
   
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#61c2bb"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quote with button"
    }
  ]
}
{% endschema %}